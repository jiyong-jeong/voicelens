# 앱은 Gemini 키를 절대 갖지 않는다. 서버(apps/server)만 키를 가진다.
# 실기기 테스트 시 localhost 대신 Mac의 LAN IP로 변경 (예: http://192.168.0.10:8787)
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_APP_TOKEN=dev-local-token
# 웹은 기본으로 "페이지 호스트:8787" 을 쓴다. 다른 주소가 필요할 때만 지정
# EXPO_PUBLIC_WEB_API_URL=https://api.example.com
